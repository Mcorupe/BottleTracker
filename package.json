{
  "name": "bottletracker",
  "description": "BottleTracker 🍼 is for anyone that needs to track feedings of infant humans 👶 or animals 😺.",
  "version": "0.0.1",
  "author": "Mark Corupe",
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "firebase": "12.0.0",
    "gatsby": "^5.14.5",
    "gatsby-plugin-firebase": "^0.2.0-beta.4",
    "gatsby-plugin-sass": "^6.14.0",
    "graphql": "^16.11.0",
    "moment": "^2.30.1",
    "postcss": "^8.5.6",
    "prop-types": "15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "6.1.0",
    "sass": "^1.89.2",
    "tailwindcss": "^4.1.11",
    "tailwindcss-spinner": "^1.2.0",
    "use-dark-mode": "^2.3.1"
  },
  "keywords": [
    "gatsby",
    "tailwind",
    "tailwindcss",
    "purgecss"
  ],
  "license": "MIT",
  "scripts": {
    "start": "npm run develop",
    "start:cache": "npm run clear:cache && npm start",
    "build": "gatsby build",
    "develop": "gatsby develop",
    "serve": "gatsby serve",
    "analyze": "npm run analyze:lint && npm run analyze:prettier",
    "fix": "npm run fix:lint && npm run fix:prettier",
    "analyze:lint": "eslint --ext .jsx --ext .js .",
    "analyze:prettier": "prettier --list-different '**/*.{js,css,md,json}'",
    "fix:lint": "eslint --ext .jsx --ext .js . --fix",
    "fix:prettier": "prettier --write '**/*.{js,css,md,json}'",
    "test": "jest --config=jest.config.js",
    "test:watch": "jest --config=jest.config.js --watch",
    "test:coverage": "jest --config=jest.config.js --collectCoverage",
    "clear:cache": "rm -rf .cache public",
    "reinstall": "rm -rf node_modules .cache public && npm cache clean --force && npm install"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-regenerator": "^7.28.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@typescript-eslint/eslint-plugin": "8.37.0",
    "@typescript-eslint/parser": "8.37.0",
    "babel-eslint": "10.1.0",
    "babel-jest": "^30.0.4",
    "babel-preset-gatsby": "^3.14.0",
    "cssnano": "^7.1.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.31.0",
    "eslint-config-react-app": "7.0.1",
    "eslint-plugin-flowtype": "8.0.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "gatsby-plugin-manifest": "5.14.0",
    "gatsby-plugin-offline": "6.14.0",
    "gatsby-plugin-postcss": "^6.14.0",
    "gatsby-plugin-purgecss": "6.2.1",
    "gatsby-plugin-react-helmet": "6.14.0",
    "gatsby-plugin-use-dark-mode": "^2.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.4",
    "prettier": "^3.6.2",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mcorupe/BottleTracker"
  },
  "bugs": {
    "url": "https://github.com/Mcorupe/BottleTracker/issues"
  },
  "overrides": {
    "use-dark-mode": {
      "react": "$react"
    },
    "eslint-config-react-app": {
      "eslint": "$eslint"
    },
    "eslint-plugin-flowtype": {
      "eslint": "$eslint"
    },
    "eslint-plugin-testing-library": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    }
  }
}
